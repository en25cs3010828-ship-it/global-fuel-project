      <aliases enabled='yes' />
      <column caption='Avg Fuel Price' datatype='real' name='[Calculation_1530306394390528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([petrol_usd_liter] + [diesel_usd_liter] + [lpg_usd_liter]) / 3' />
      </column>
      <column caption='Diesel Volatility' datatype='real' name='[Calculation_1530306766057473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV([diesel_usd_liter]) / AVG([diesel_usd_liter])' />
      </column>
